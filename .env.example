# Optional: a Formspree-compatible endpoint for the contact form.
# Create a form at https://formspree.io (free tier is fine), then set e.g.:
# VITE_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxxx
# When unset, the form falls back to opening the visitor's email client (mailto:).
VITE_CONTACT_ENDPOINT=
